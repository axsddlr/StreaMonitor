# Streamonitor configuration
# Copy this file to .env and adjust values as needed

# Download directory
STRMNTR_DOWNLOAD_DIR=downloads

# Path to config file
STRMNTR_CONFIG=config.json

# Stripchat mouflon keys
STRMNTR_MOUFLON_KEYS=stripchat_mouflon_keys.json

# Minimum free disk space before pausing downloads
# Percentage of total disk (default: 5%)
STRMNTR_MIN_FREE_SPACE=5
# Absolute GB free (0 = disabled, checked alongside percentage)
STRMNTR_MIN_FREE_SPACE_GB=0

# Enable debug logging
STRMNTR_DEBUG=False

# HTTP User-Agent header
# STRMNTR_USER_AGENT=Mozilla/5.0 (X11; Ubuntu; Linux x86_64; rv:135.0) Gecko/20100101 Firefox/135.0

# Path to ffmpeg binary
# STRMNTR_FFMPEG_PATH=ffmpeg

# Target video resolution (height in pixels)
# STRMNTR_RESOLUTION=1080

# Resolution match policy: exact, exact_or_least_higher, exact_or_highest_lower, closest
# STRMNTR_RESOLUTION_PREF=closest

# Output container: mp4 or mkv
# STRMNTR_CONTAINER=mp4

# Append VR format suffix to filenames
# STRMNTR_VR_FORMAT_SUFFIX=True

# FFmpeg readrate (0, 1, or 1.3)
# STRMNTR_FFMPEG_READRATE=1.3

# Segment time in seconds, or None for single file
# STRMNTR_SEGMENT_TIME=

# Web UI host (0.0.0.0 for remote access)
# STRMNTR_HOST=127.0.0.1

# Web UI port
# STRMNTR_PORT=5000

# Web UI password (username: admin)
# STRMNTR_PASSWORD=admin
